# To separate your traces from other application
LANGSMITH_PROJECT=new-agent

# Optional overrides. If omitted, the app falls back to ~/.codex/auth.json
# for OPENAI_API_KEY and ~/.codex/config.toml for OPENAI_BASE_URL / model.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-5.4
# OPENAI_SYSTEM_PROMPT=You are a concise calendar assistant.
